      "width": "{{width}}",
      "height": "{{height}}"
    },
    "class_type": "ModelSamplingFlux",
    "_meta": {
      "title": "Flux sampling settings"
    }
  },
  "6": {
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "4",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive prompt"
    }
  },
  "7": {
    "inputs": {
      "conditioning": [
        "6",
        0
      ],
      "guidance": 3.5
    },
    "class_type": "FluxGuidance",
    "_meta": {
      "title": "Flux guidance"
    }
  },
  "8": {
    "inputs": {
      "model": [
        "5",
        0
      ],
      "conditioning": [
        "7",
        0
      ]
    },
    "class_type": "BasicGuider",
    "_meta": {
      "title": "Basic guider"
    }
  },
  "9": {
    "inputs": {
      "noise_seed": [
        "16",
        0
      ]
    },
    "class_type": "RandomNoise",
    "_meta": {
      "title": "Random seed"
    }
  },
  "10": {
    "inputs": {
      "sampler_name": "euler_ancestral"
    },
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "Sampler"
    }
  },
  "11": {
    "inputs": {
      "model": [
        "5",
        0
      ],
      "scheduler": "sgm_uniform",
      "steps": 4,
      "denoise": 1
    },
    "class_type": "BasicScheduler",
    "_meta": {
      "title": "Scheduler"
    }
  },
  "12": {
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "Latent size"
    }
  },
  "13": {
    "inputs": {
      "noise": [
        "9",
        0
      ],
      "guider": [
        "8",
        0
      ],
      "sampler": [
        "10",
        0
      ],
      "sigmas": [
        "11",
        0
      ],
      "latent_image": [
        "12",
        0
      ]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": {
      "title": "Generate latent"
    }
  },
  "14": {
    "inputs": {
      "samples": [
        "13",
        0
      ],
      "vae": [
        "3",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode image"
    }
  },
  "15": {
    "inputs": {
      "filename_prefix": "rpgraph_flux2_klein",
      "images": [
        "14",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save image"
    }
  },
  "16": {
    "inputs": {
      "seed": -1
    },
    "class_type": "Seed (rgthree)",
    "_meta": {
      "title": "Scene seed"
    }
  }
