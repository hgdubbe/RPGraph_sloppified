{
  "1": {
    "inputs": {
      "unet_name": "{{diffusion_model}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Flux 2 Klein diffusion model"
    }
  },
  "2": {
    "inputs": {
      "clip_name": "{{text_encoder}}",
      "type": "flux2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load Flux 2 text encoder"
    }
  },
  "3": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load Flux 2 VAE"
    }
  },
  "4": {
    "inputs": {
      "model": [
        "1",
        0
      ],
      "clip": [
        "2",
        0
      ],
      "lora_01": "{{lora_01}}",
      "strength_01": "{{lora_strength_01}}",
      "lora_02": "{{lora_02}}",
      "strength_02": "{{lora_strength_02}}",
      "lora_03": "{{lora_03}}",
      "strength_03": "{{lora_strength_03}}",
      "lora_04": "{{lora_04}}",
      "strength_04": "{{lora_strength_04}}"
    },
    "class_type": "Lora Loader Stack (rgthree)",
    "_meta": {
      "title": "Optional RPGraph LoRA stack"
    }
  },
  "5": {
    "inputs": {
      "model": [
        "4",
        0
      ],
      "max_shift": 1.15,
